{
  "name": "acumedis-api",
  "version": "1.0.0",
  "private": true,
  "description": "API Android AcuMedis: JWT auth, pasien, sesi terapi, jadwal, stok, pengeluaran",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "prisma db push --accept-data-loss && prisma generate",
    "seed": "node src/seed.js",
    "test": "node --test test/*.test.js"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "fastify": "^4.28.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "prisma": "5.22.0"
  }
}
